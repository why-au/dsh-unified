{
  "name": "@dsh-unified/dsh-plugin",
  "version": "0.1.20",
  "description": "DSH plugin integrating subscription, API-key and IDE model channels with multi-account rotation and a unified channel panel. Provider availability and authentication support vary by deployment.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.bundle.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-api-session-controller"],
      "external": ["react", "react-dom"]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subscriptions",
    "llm"
  ],
  "dependencies": {
    "socks": "^2.8.9",
    "undici": "8.10.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@earendil-works/pi-ai": "0.85.1",
    "react": "^18.2.0"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs && node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke:zen": "node test/zen-smoke.mjs"
  },
  "files": [
    "lib/",
    "NOTICE.md",
    "README.md",
    "cordis.patch.yml",
    "LICENSE"
  ]
}